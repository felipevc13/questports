{
  // Site Worker. Nitro merges this into .output/server/wrangler.json at build.
  // Deploy by hand: npm run deploy:cf. Needs `wrangler login` first.
  "name": "questports",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "questports.com", "custom_domain": true },
    { "pattern": "www.questports.com", "custom_domain": true }
  ],
  // Prerendered pages live at <path>/index.html; serve /ports/slug without a 307 to /ports/slug/.
  "assets": { "binding": "ASSETS", "directory": "../public", "html_handling": "drop-trailing-slash" },
  "observability": { "enabled": false }
}
