# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key

# Server-only. Set these in the Vercel project, not in the browser.
# The service role writes verification rows. The anon key above cannot insert.
SUPABASE_SERVICE_ROLE_KEY=
# Secret for Felipe's manual form (POST /api/admin/verifications).
VERIFICATION_ADMIN_SECRET=

# Optional. Mixed into the daily analytics visitor hash. If empty, the server
# hashes SUPABASE_SERVICE_ROLE_KEY instead. Production collects stats unless
# ANALYTICS_ENABLED=false. Local dev and Vercel preview stay off unless this is true.
ANALYTICS_SALT=
# ANALYTICS_ENABLED=

# Cloudflare Workers. The token is a secret. The account id is not a token;
# it is the account that owns questports-media and questports-apk-proxy.
# npm run media:deploy reads both. npm run media:deploy:dry does not upload.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=42ef7aadef9e38f2860f59f826a090e9

# Unset uses https://questports-media.questports.workers.dev.
# An empty string serves covers from this site and turns MP4 previews off.
# NUXT_PUBLIC_MEDIA_BASE=
# Unset uses https://questports-apk-proxy.questports.workers.dev.
# An empty string uses this site's /api/apk-proxy (Vercel transfer).
# NUXT_PUBLIC_APK_PROXY_BASE=
# Byte cap for the Vercel APK route only. The Worker has no cap.
# APK_PROXY_MAX_BYTES=
